{
  "name": "novas",
  "version": "1.0.0",
  "private": true,
  "description": "Open-source news reader powered by News API, with weather and market widgets.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint --type-aware",
