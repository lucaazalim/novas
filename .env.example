# Public URL of the deployed site. Used for canonical URLs, Open Graph, robots and the sitemap.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# News providers. Configure at least one; results from every configured provider are merged.
# https://newsapi.org/ (US headlines and full-text search)
NEWS_API_KEY=""
# https://newsdata.io/ (headlines for 200+ countries)
NEWSDATA_API_KEY=""
# https://gnews.io/ (Google News rankings for 70 countries)
GNEWS_API_KEY=""

# Optional: point the News API client at a different base URL (e.g. a local mock).
# NEWS_API_BASE_URL="https://newsapi.org/v2"
